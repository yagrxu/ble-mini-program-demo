page {
  background: #f4f5f7;
  color: #1c1c1e;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
}

.container {
  padding: 32rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.btn {
  background: #0a84ff;
  color: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
  margin-bottom: 16rpx;
}

.btn--secondary {
  background: #e5e5ea;
  color: #1c1c1e;
}

.btn--danger {
  background: #ff3b30;
  color: #fff;
}

.muted {
  color: #8e8e93;
  font-size: 24rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.mono {
  font-family: SFMono-Regular, Menlo, monospace;
  font-size: 24rpx;
  word-break: break-all;
}
